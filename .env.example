# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/event_management"
DATABASE_POOL_SIZE=20

# ============================================
# JWT & AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=10

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ============================================
# NEXTJS FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME="إدارة العلاقات العامة والمراسم"

# ============================================
# EMAIL CONFIGURATION (SendGrid)
# ============================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@government-entity.gov

# ============================================
# WHATSAPP BUSINESS API (Meta)
# ============================================
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_API_KEY=your-whatsapp-api-key
WHATSAPP_BUSINESS_API_URL=https://graph.instagram.com/v18.0

# ============================================
# QR CODE & SECURITY
# ============================================
QR_CODE_ENCRYPTION_KEY=your-qr-encryption-key-min-32-chars
QR_CODE_SECRET_SALT=your-salt-for-qr-codes

# ============================================
# FILE UPLOAD (Optional Cloud Storage)
# ============================================
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=event-management-bucket
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# REDIS (Optional - for real-time caching)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# ADMIN/DEVELOPER ACCOUNT (Initial Setup)
# ============================================
ADMIN_EMAIL=admin@government-entity.gov
ADMIN_PASSWORD=change-me-in-production
ADMIN_FULL_NAME=System Administrator